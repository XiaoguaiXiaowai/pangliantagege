# ============================================================
# Docker 部署环境变量模板
# 使用：cp docker.env.example docker.env  然后修改密码等敏感项
# （docker.env 已被 .gitignore 排除，不会提交到仓库）
# 用法：docker compose --env-file docker.env up -d --build
# ============================================================

# ---------- 数据库（MySQL 容器与 Django 共用） ----------
# Django 连接用的库名
DB_NAME=pangliantagege
# Django 连接用的账号（compose 会自动在 MySQL 里创建该账号并授权此库）
DB_USER=pltgg
# 请改成强密码（同时作为 Django 密码与 MySQL 应用账号密码）
DB_PASSWORD=change-me-please
# MySQL root 密码（初始化容器时使用，也用于导入数据快照等运维操作）
MYSQL_ROOT_PASSWORD=change-me-please

# ---------- Django ----------
# 生产环境必须为 false
DJANGO_DEBUG=false
# 允许访问的域名（逗号分隔）
ALLOWED_HOSTS=www.pangliantagege.top,pangliantagege.top,localhost,127.0.0.1
# CSRF 信任来源（HTTPS 必须带上 https:// 前缀）
CSRF_TRUSTED_ORIGINS=https://www.pangliantagege.top,https://pangliantagege.top
# 跨域白名单
CORS_ALLOWED_ORIGINS=https://www.pangliantagege.top,https://pangliantagege.top

# ---------- RAG AI 服务（可选） ----------
# 格式 host:port，例如 192.168.1.100:8001。
# 留空时 /api/ai/health/ 健康检查回退到 127.0.0.1:8001（容器内不可达，会显示断开）。
# 当前版本暂未在 nginx 中代理 /api/chat，需要时见 frontend/nginx.conf 中的注释说明。
RAG_PROXY_TARGET=
